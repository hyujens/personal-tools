# syntax=docker/dockerfile:1
FROM devenv-base:latest

USER root
RUN dnf update -y && dnf install -y gcc gcc-c++ make python3-devel pkgconf-pkg-config && dnf clean all

USER developer

RUN curl -LsSf https://astral.sh/uv/install.sh | sh

RUN <<'EOF'
cat > /home/developer/.config/nvim/lazyvim.json <<'JSON'
{
  "extras": [
    "lazyvim.plugins.extras.lang.python"
  ],
  "version": 8
}
JSON
EOF

RUN nvim --headless "+Lazy! sync " +qa
CMD ["bash"]
